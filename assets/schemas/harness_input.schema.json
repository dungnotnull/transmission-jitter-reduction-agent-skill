{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transmission-jitter-reduction/schemas/harness_input.schema.json",
  "title": "HarnessInput",
  "description": "Run context accepted by tjr-harness / tjr-agent. Extra unknown keys are ignored (forward-compatible).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "query": { "type": "string", "description": "Free-text user query; drives pre-flight language detection and routing." },
    "rtt_samples": { "type": "array", "description": "Round-trip-time samples in milliseconds.", "items": { "type": "number", "minimum": 0 } },
    "idle_latency_ms": { "type": ["number", "null"], "minimum": 0 },
    "latency_under_load_ms": { "type": ["number", "null"], "minimum": 0 },
    "upload_mbps": { "type": ["number", "null"], "minimum": 0 },
    "download_mbps": { "type": ["number", "null"], "minimum": 0 },
    "flow_count": { "type": "integer", "minimum": 1, "default": 1 },
    "link_type": { "type": "string", "default": "generic" },
    "game": { "type": ["string", "null"] },
    "traffic_class": { "type": "string", "default": "game" },
    "tickrate_hz": { "type": "integer", "minimum": 1, "default": 64 },
    "wifi_band": { "type": "string", "enum": ["2.4", "5", "6"], "default": "5" },
    "wifi_width_mhz": { "type": "integer", "minimum": 20, "default": 80 },
    "wifi_scans": { "type": "array", "items": { "type": "object" } },
    "isp_limited": { "type": "boolean", "default": false },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "knowledge_citations": { "type": "array", "items": { "type": "object" } },
    "audience": { "type": "string", "default": "gamer" },
    "scope": { "type": "string", "default": "home network jitter reduction" },
    "timeframe": { "type": "string", "default": "current" }
  }
}